{
  "$description": "Square Hole brand tokens (dark theme). Values match the Square Hole app's design tokens (packages/design/src/styles/tokens.css, from the handoff palette) plus the colours of the mark. Source of truth for colors/tokens.css and the contrast table in colors/README.md (node scripts/tokens.mjs).",
  "color": {
    "canvas": { "$type": "color", "$value": "#080D16", "css": "--sh-canvas", "name": "Navy", "use": "Page background; the brand's base colour" },
    "surface": { "$type": "color", "$value": "#111B29", "css": "--sh-surface", "use": "Cards and panels" },
    "surface-raised": { "$type": "color", "$value": "#18253A", "css": "--sh-surface-raised", "use": "Raised elements, menus" },
    "panel-top": { "$type": "color", "$value": "#142033", "css": "--sh-panel-top", "use": "Top stop of the panel gradient" },
    "selected": { "$type": "color", "$value": "#241E4F", "css": "--sh-selected", "use": "Selected navigation item" },
    "border": { "$type": "color", "$value": "#30415D", "css": "--sh-border", "use": "Decorative separators only" },
    "border-strong": { "$type": "color", "$value": "#63769B", "css": "--sh-border-strong", "use": "Control outlines (3:1 or more on every surface)" },
    "text": { "$type": "color", "$value": "#F3F5FB", "css": "--sh-text", "use": "Primary text, the wordmark on dark" },
    "text-secondary": { "$type": "color", "$value": "#B5C0D5", "css": "--sh-text-secondary", "use": "Secondary text, taglines" },
    "text-muted": { "$type": "color", "$value": "#899AB6", "css": "--sh-text-muted", "use": "Captions and meta text" },
    "accent": { "$type": "color", "$value": "#A78BFA", "css": "--sh-accent", "name": "Lavender", "use": "The brand colour: the glowing hole, links, focus rings, the flat mark" },
    "action": { "$type": "color", "$value": "#6D4AE2", "css": "--sh-action", "name": "Violet", "use": "Fill of primary buttons (white text); never text on dark, never the only colour of a mark" },
    "action-hover": { "$type": "color", "$value": "#5B39D0", "css": "--sh-action-hover", "use": "Hover fill of primary buttons" },
    "on-action": { "$type": "color", "$value": "#FFFFFF", "css": "--sh-on-action", "use": "Text on the violet fill" },
    "glow": { "$type": "color", "$value": "#C4B2FF", "css": "--sh-brand-glow", "name": "Glow", "use": "Light of the hole (decoration only, never text)" },
    "neon-core": { "$type": "color", "$value": "#F4F0FF", "css": "--sh-brand-neon-core", "use": "Bright core of the hole's lip in the mark (decoration only)" },
    "tile-top": { "$type": "color", "$value": "#1D2B46", "css": "--sh-brand-tile-top", "use": "Top of the mark's tile gradient" },
    "tile-bottom": { "$type": "color", "$value": "#0B111D", "css": "--sh-brand-tile-bottom", "use": "Bottom of the mark's tile gradient" },
    "hole-lining": { "$type": "color", "$value": "#2A1D3A", "css": "--sh-brand-hole-lining", "use": "Top of the hole's well" },
    "hole": { "$type": "color", "$value": "#05070C", "css": "--sh-brand-hole", "use": "Bottom of the hole's well" },
    "positive": { "$type": "color", "$value": "#62DCA3", "css": "--sh-positive", "use": "UI state only, always with a sign or arrow; never in brand art or around the mark" },
    "negative": { "$type": "color", "$value": "#FF8CA8", "css": "--sh-negative", "use": "UI state only, always with a sign or arrow; never in brand art or around the mark" },
    "warning": { "$type": "color", "$value": "#FFD17A", "css": "--sh-warning", "use": "UI state and the Demo badge only; never in brand art" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Plus Jakarta Sans Variable", "Plus Jakarta Sans", "ui-sans-serif", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"], "css": "--sh-font" },
    "weight-wordmark": { "$type": "fontWeight", "$value": 750, "css": "--sh-weight-wordmark", "use": "The wordmark and display headings" },
    "weight-bold": { "$type": "fontWeight", "$value": 700, "css": "--sh-weight-bold", "use": "Headings, labels" },
    "weight-medium": { "$type": "fontWeight", "$value": 550, "css": "--sh-weight-medium", "use": "Taglines, emphasis" },
    "weight-regular": { "$type": "fontWeight", "$value": 400, "css": "--sh-weight-regular", "use": "Body text" },
    "tracking-wordmark": { "$type": "dimension", "$value": "-0.02em", "css": "--sh-tracking-wordmark", "use": "Letter spacing of the wordmark" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "16px", "css": "--sh-radius-card" },
    "control": { "$type": "dimension", "$value": "10px", "css": "--sh-radius-control" },
    "mark-tile": { "$type": "dimension", "$value": "22.66%", "css": "--sh-radius-mark", "use": "Corner radius of the mark's tile (58 on its 256 grid)" }
  }
}
